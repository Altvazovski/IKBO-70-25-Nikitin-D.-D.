#!/bin/bash
# Задача 3: программа banner - выводит текст в рамке,
# размер рамки автоматически подстраивается под длину текста.
#
# Использование: ./banner "текст"

if [ $# -ne 1 ]; then
    echo "Использование: $0 \"текст\"" >&2
    exit 1
fi

text="$1"
len=${#text}
width=$((len + 2))   # +2 -- по одному пробелу-отступу с каждой стороны текста

# printf '%*s' width ''  печатает $width пробелов (пустая строка,
# выровненная по ширине $width), tr заменяет пробелы на дефисы.
border=$(printf '%*s' "$width" '' | tr ' ' '-')

printf '+%s+\n' "$border"
printf '| %s |\n' "$text"
printf '+%s+\n' "$border"

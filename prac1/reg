#!/bin/bash
# Задача 5: "регистрация" пользовательской команды -
# устанавливает правильные права доступа (исполняемый, читаемый
# всеми, но менять его может только владелец) и копирует программу
# в /usr/local/bin, чтобы её можно было запускать из любого места.
#
# Использование: ./reg <программа>
# Пример:        ./reg banner   ->  теперь доступна команда: banner

set -euo pipefail

if [ $# -ne 1 ]; then
    echo "Использование: $0 <программа>" >&2
    exit 1
fi

PROG="$1"
DEST_DIR="/usr/local/bin"

if [ ! -f "$PROG" ]; then
    echo "Ошибка: файл '$PROG' не найден" >&2
    exit 1
fi

# 755 = rwxr-xr-x: владелец может читать/писать/выполнять,
# остальные - только читать и выполнять. Это стандартные права
# для исполняемых файлов, устанавливаемых в системные каталоги.
chmod 755 "$PROG"

# Копирование в /usr/local/bin обычно требует прав root.
if [ -w "$DEST_DIR" ]; then
    cp -f "$PROG" "$DEST_DIR/"
else
    sudo cp -f "$PROG" "$DEST_DIR/"
fi

BASENAME=$(basename "$PROG")
echo "Команда '$BASENAME' зарегистрирована в $DEST_DIR и готова к использованию."
